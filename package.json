{
  "name": "seguimiento-comercial-cmd",
  "version": "1.2.0",
  "description": "App Seguimiento Comercial - Proceso Preventa y Venta - Cooperativa Minuto de Dios",
  "main": "main.js",
  "author": "Juan Orrego",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win --x64",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.cmd.seguimientocomercial",
    "productName": "Seguimiento Comercial CMD",
    "copyright": "© 2026 Juan Orrego - Cooperativa Minuto de Dios",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "app/**/*",
      "preload.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "app/icon-512.png",
      "signingHashAlgorithms": null,
      "sign": null
    },
    "forceCodeSigning": false,
    "publish": {
      "provider": "github",
      "owner": "orregomejiaj-gif",
      "repo": "SeguimientoComercialCMD",
      "private": true,
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Seguimiento CMD",
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "cross-env": "^7.0.3"
  },
  "dependencies": {
    "electron-updater": "^6.1.0"
  }
}
